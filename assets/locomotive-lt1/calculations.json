  "formulas": [
    "Q = Dp * np * eta_pv / 1000 (L/min)",
    "nm = (Q / 2) * 1000 * eta_mv / Dm",
    "v = (nm/i)*pi*d/60",
    "Tm = dp_bar * Dm_cc * eta_mt / (20*pi)",
    "F = 2 * Tm * i * eta_g / (d/2)",
    "P_engine = F_running*v/(1000*eta_total) + P_aux",
    "a = (min(F_drive,mu*m_powered*g)-F_start)/m_train",
    "mid ordinate = R - sqrt(R^2-(L/2)^2)"
